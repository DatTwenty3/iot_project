        "configuration": {
          "scriptLang": "JS",
          "jsScript": "// Assuming 'msg' contains the incoming telemetry data\nvar telemetryData = msg.telemetry; // This should be the incoming telemetry object\n\n// Check if telemetryData exists\nif (telemetryData) {\n    // Copy values from telemetry to attributes\n    msg.attributes = {\n        test_temp: telemetryData.temp, // Copy temperature\n        test_humid: telemetryData.humidity        // Copy humidity\n    };\n}\n\nreturn { msg: msg,\n   metadata: metadata,\n   msgType: \"POST_ATTRIBUTES_REQUEST\" }",
